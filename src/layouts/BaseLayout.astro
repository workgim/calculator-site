---
/**
 * 모든 페이지의 공통 뼈대. (docs/12-page-structure.md §4)
 * 페이지는 이 레이아웃을 감싸고 <slot/> 자리에 자기 내용만 채운다.
 */
import '../styles/global.css';
import { SITE } from '../config/site';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  /** 검색결과용 제목 (docs/23-content-guide.md §1.7) */
  seoTitle?: string;
  noindex?: boolean;
  /** 넓은 컨테이너(홈 등)를 쓸지 여부 */
  wide?: boolean;
}

const { title, description, path, seoTitle, noindex, wide = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <script is:inline>
      // 테마 초기화: 저장된 선택이 있으면 first paint 전에 적용 (FOUC 방지).
      // 저장값이 없으면 속성을 두지 않아 @media (prefers-color-scheme) 가 적용됨.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <Head title={title} description={description} path={path} seoTitle={seoTitle} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    <Header />

    <div class={wide ? 'container container--wide' : 'container'}>
      <AdSlot position="top" />
    </div>

    <main id="main" class={wide ? 'container container--wide' : 'container'}>
      <slot />
    </main>

    <div class={wide ? 'container container--wide' : 'container'}>
      <AdSlot position="bottom" />
    </div>

    <Footer />
  </body>
</html>
