---
/**
 * Google Analytics 4. `SITE.gaId` 가 설정된 경우에만 로드한다.
 * - 로더는 async 로 불러 성능 영향 최소화
 * - GA4 는 기본적으로 IP 를 익명 처리하며 개인 식별 정보를 수집하지 않음
 * - 쿠키 고지는 privacy.astro (SITE.gaId 값에 따라 문구가 달라짐)
 */
import { SITE } from '../config/site';
const id = SITE.gaId;
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
