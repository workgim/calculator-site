---
/**
 * Google Analytics 4 (gtag.js) — 표준 설치 방식.
 * `SITE.gaId` 가 설정된 경우에만 로드한다.
 *
 * 이전에는 성능(Lighthouse) 때문에 idle/첫 상호작용 시점까지 지연 삽입했으나,
 * GA 설치 테스트·태그 어시스턴트가 태그를 감지하지 못하고 실사용 환경에서
 * 검증이 어려워 표준 방식(<head> 에 async 스크립트)으로 되돌림. (2026-09-10)
 * `async` 라서 HTML 파싱을 막지는 않는다.
 *
 * GA4 는 IP 를 익명 처리하며 개인 식별 정보를 수집하지 않는다.
 * 쿠키 고지는 privacy.astro (SITE.gaId 유무로 문구 분기).
 */
import { SITE } from '../config/site';
const id = SITE.gaId;
---

{id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />}
{
  id && (
    <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${id}');`} />
  )
}
