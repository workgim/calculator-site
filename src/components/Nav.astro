---
/** 주요 내비게이션: 카테고리별 드롭다운. (docs/12-page-structure.md §3) */
import { CATEGORIES } from '../data/categories';
import { getCalculatorsByCategory } from '../data/calculators';
import Icon from './Icon.astro';
import IconBadge from './IconBadge.astro';
---

<nav aria-label="주요" class="nav">
  <ul>
    <li><a href="/" class="nav__link">홈</a></li>
    {
      CATEGORIES.map((c) => {
        const items = getCalculatorsByCategory(c.id);
        const panelId = `navmenu-${c.id}`;
        return (
          <li class="nav__item">
            <button type="button" class="nav__btn" aria-expanded="false" aria-controls={panelId}>
              {c.name}
              <Icon name="chevron-down" size={14} class="nav__chev" />
            </button>
            <div class="nav__panel" id={panelId}>
              <a class="nav__panel-all" href={`/#${c.id}`}>{c.name} 전체 보기</a>
              {items.map((it) => (
                <a class="nav__panel-item" href={`/calc/${it.slug}`}>
                  <IconBadge name={it.icon} cat={it.category} size="sm" />
                  <span>{it.title}</span>
                </a>
              ))}
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav {
    position: relative;
    min-width: 0;
    flex: 1 1 auto;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .nav li {
    margin: 0;
  }
  .nav__item {
    position: relative;
  }

  .nav__link,
  .nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    color: var(--color-text);
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background var(--transition), color var(--transition);
  }
  .nav__link:hover,
  .nav__btn:hover,
  .nav__item:hover .nav__btn,
  .nav__item[data-open] .nav__btn {
    color: var(--color-primary);
    background: var(--color-surface);
  }
  .nav__btn :global(.nav__chev) {
    transition: transform var(--transition);
  }
  .nav__item:hover .nav__btn :global(.nav__chev),
  .nav__item[data-open] .nav__btn :global(.nav__chev) {
    transform: rotate(180deg);
  }

  .nav__panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 50;
    min-width: 15rem;
    max-width: calc(100vw - 2 * var(--space-4));
    padding: var(--space-2);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--transition),
      transform var(--transition),
      visibility var(--transition);
  }
  /* 버튼–패널 사이 hover 유지용 투명 다리 */
  .nav__panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * var(--space-2));
    height: var(--space-2);
  }
  .nav__item:hover > .nav__panel,
  .nav__item[data-open] > .nav__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .nav__panel-all {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-1);
  }
  .nav__panel-all:hover {
    color: var(--color-primary);
  }
  .nav__panel-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .nav__panel-item:hover {
    background: var(--color-surface);
    color: var(--color-primary);
  }

  /* 좁은 화면: 패널을 내비 전체 폭으로 */
  @media (max-width: 48rem) {
    .nav__item {
      position: static;
    }
    .nav__panel {
      left: 0;
      right: 0;
      min-width: 0;
      max-width: none;
    }
  }
  /* 넓은 화면: 한 줄, 오른쪽 끝 카테고리는 패널을 오른쪽 정렬 */
  @media (min-width: 48rem) {
    .nav ul {
      flex-wrap: nowrap;
    }
    .nav__item:nth-last-child(-n + 2) .nav__panel {
      left: auto;
      right: 0;
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.nav__item'));

  function closeAll(except?: HTMLElement) {
    for (const it of items) {
      if (it === except) continue;
      it.removeAttribute('data-open');
      it.querySelector('.nav__btn')?.setAttribute('aria-expanded', 'false');
    }
  }

  for (const it of items) {
    const btn = it.querySelector<HTMLButtonElement>('.nav__btn');
    if (!btn) continue;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = it.hasAttribute('data-open');
      closeAll(it);
      if (isOpen) {
        it.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        it.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav__item')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
