---
/**
 * 인라인 SVG 아이콘. Lucide (ISC 라이선스) 아이콘의 path 데이터만 담는다.
 * `currentColor` 로 그려서 라이트/다크 자동 대응. 외부 요청 없음.
 * 새 아이콘은 https://lucide.dev 에서 이름 찾아 <svg> 안쪽만 여기 추가.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const PATHS: Record<string, string> = {
  // 카테고리
  banknote:
    '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
  house:
