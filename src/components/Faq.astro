---
/**
 * 자주 묻는 질문. `<details>` 아코디언 (JS 0). (docs/23-content-guide.md §1.5)
 * FAQPage 구조화 데이터는 넣지 않는다 (2026-05 리치결과 폐지, 유지보수만 늘어남).
 *
 * 사용: <Faq items={[{ q: '...', a: '...' }]} />
 *  - a 는 일반 텍스트. 여러 문단은 \n 로 구분하면 <p> 로 나뉜다.
 */
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">자주 묻는 질문</h2>
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div class="faq__a">
            {item.a.split('\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </details>
      ))}
    </section>
  )
}
