---
/**
 * 테마 전환 버튼 (헤더). 시스템 → 라이트 → 다크 순환.
 * - FOUC 방지용 초기화는 BaseLayout <head> 의 인라인 스크립트가 담당.
 * - 아이콘 표시는 global.css 의 :root[data-theme] 규칙이 담당(JS 불필요).
 */
---

<button type="button" class="theme-toggle" aria-label="테마 전환">
  <svg
    class="ti-system"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg
    class="ti-light"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="ti-dark"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (btn) {
    const order = ['system', 'light', 'dark'] as const;
    const label: Record<string, string> = { system: '시스템 설정', light: '라이트', dark: '다크' };
    const current = () => document.documentElement.dataset.theme || 'system';

    const syncLabel = () => {
      const c = current();
      const next = order[(order.indexOf(c as (typeof order)[number]) + 1) % order.length];
      btn.setAttribute('aria-label', `테마: ${label[c]} (클릭하면 ${label[next]})`);
    };
    syncLabel();

    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(current() as (typeof order)[number]) + 1) % order.length];
      try {
        if (next === 'system') {
          delete document.documentElement.dataset.theme;
          localStorage.removeItem('theme');
        } else {
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        }
      } catch (e) {
        if (next === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = next;
      }
      syncLabel();
    });
  }
</script>
