---
/**
 * 이동 경로: 홈 > 카테고리 > 현재. (docs/12-page-structure.md §3, §5)
 * BreadcrumbList 구조화 데이터도 함께 출력. (docs/20-seo-google.md §4)
 */
import { SITE } from '../config/site';

interface Crumb {
  name: string;
  /** 마지막 항목은 href 생략 */
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    ...(item.href ? { item: new URL(item.href, SITE.url).href } : {}),
  })),
};
---

<nav aria-label="이동 경로" class="breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.name}</a>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<style>
  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .breadcrumb li {
    margin: 0;
  }
  .breadcrumb li + li::before {
    content: '›';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
