---
/** 없는 주소 처리. (docs/12-page-structure.md §7) */
import { CALCULATORS } from '../data/calculators';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청하신 페이지가 없습니다. 전체 계산기 목록에서 원하는 계산기를 찾아보세요."
  path="/404"
  noindex
>
  <h1>페이지를 찾을 수 없습니다 (404)</h1>
  <p>주소가 바뀌었거나 삭제된 페이지입니다.</p>
  <p><a href="/">홈으로 가기</a></p>

  <h2>전체 계산기</h2>
  <ul>
    {CALCULATORS.map((c) => <li><a href={`/calc/${c.slug}`}>{c.title}</a></li>)}
  </ul>
</BaseLayout>
