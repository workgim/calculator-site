---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcBmr, type BmrInput } from '../../lib/bmr';

const calculator = getCalculator('bmr')!;

const kcal = (n: number) => n.toLocaleString('ko-KR') + ' kcal';
const profiles: { label: string; input: BmrInput }[] = [
  { label: '남 30세 170cm 70kg', input: { sex: 'male', age: 30, heightCm: 170, weightKg: 70, activity: 'moderate' } },
  { label: '남 40세 175cm 80kg', input: { sex: 'male', age: 40, heightCm: 175, weightKg: 80, activity: 'moderate' } },
  { label: '여 30세 160cm 55kg', input: { sex: 'female', age: 30, heightCm: 160, weightKg: 55, activity: 'moderate' } },
  { label: '여 40세 160cm 60kg', input: { sex: 'female', age: 40, heightCm: 160, weightKg: 60, activity: 'moderate' } },
];
const profileRows = profiles.map((p) => ({ label: p.label, ...calcBmr(p.input) }));
const ex = calcBmr({ sex: 'male', age: 30, heightCm: 175, weightKg: 70, activity: 'sedentary' });

const FAQ = [
  {
    q: '기초대사량과 유지 칼로리는 어떻게 다른가요?',
    a: '기초대사량은 아무것도 안 하고 누워만 있어도 쓰는 칼로리이고, 유지 칼로리(TDEE)는 여기에 일상활동·운동량을 곱한 값입니다. 실제로 먹어야 하는 기준은 유지 칼로리입니다.',
  },
  {
    q: '하루에 몇 kcal 먹어야 살이 빠지나요?',
    a: '유지 칼로리보다 하루 300~500kcal 적게 먹으면 주 약 0.3~0.5kg 감량됩니다. 너무 적게 먹으면 근손실·요요 위험이 커집니다.',
  },
  {
    q: '활동량은 어떻게 고르나요?',
    a: '사무직·거의 안 움직임은 "좌식", 주 1~3회 가벼운 운동은 "가벼운 운동", 주 3~5회는 "보통"이 무난합니다. 애매하면 한 단계 낮게 잡는 편이 안전합니다.',
  },
  {
    q: 'Harris-Benedict 공식과 결과가 다른 이유는?',
    a: '두 공식은 계수가 다릅니다. Mifflin-St Jeor가 현대 체형에 더 잘 맞는다고 알려져 이 계산기의 기본으로 씁니다.',
  },
  {
    q: '기초대사량을 높이려면?',
    a: '근육량을 늘리면 기초대사량이 올라갑니다. 근력 운동과 충분한 단백질 섭취가 도움이 됩니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="bmr-form">
      <div class="calc-row">
        <div class="calc-field">
          <label for="sex">성별</label>
          <select id="sex">
            <option value="male">남성</option>
            <option value="female">여성</option>
          </select>
        </div>
        <div class="calc-field">
          <label for="age">나이 (만)</label>
          <input type="number" id="age" inputmode="numeric" min="1" max="120" step="1" placeholder="예: 30" required />
        </div>
      </div>
      <div class="calc-row">
        <div class="calc-field">
          <label for="height">키 (cm)</label>
          <input type="number" id="height" inputmode="decimal" step="0.1" min="50" max="300" placeholder="예: 170" required />
        </div>
        <div class="calc-field">
          <label for="weight">몸무게 (kg)</label>
          <input type="number" id="weight" inputmode="decimal" step="0.1" min="2" max="500" placeholder="예: 65" required />
        </div>
      </div>
      <div class="calc-field">
        <label for="activity">활동 수준</label>
        <select id="activity">
          <option value="sedentary">거의 운동 안 함 (좌식 생활)</option>
          <option value="light">가벼운 운동 (주 1~3회)</option>
          <option value="moderate" selected>보통 운동 (주 3~5회)</option>
          <option value="active">활발한 운동 (주 6~7회)</option>
          <option value="veryActive">매우 활발 (육체노동/선수)</option>
        </select>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="bmr-result" class="calc-result" hidden></output>
    <p id="bmr-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>기초대사량(BMR)이란?</h2>
    <p>
      아무 활동 없이 <strong>생명 유지에만 쓰이는 하루 최소 칼로리</strong>입니다. 호흡, 체온 유지,
      장기 활동 등에 소비되며, 하루 총 소비 칼로리의 60~70%를 차지합니다.
    </p>
  </section>

  <section>
    <h2>기초대사량 계산 공식</h2>
    <p>Mifflin-St Jeor 공식을 사용합니다.</p>
    <ul>
      <li>남성: BMR = 10 × 체중(kg) + 6.25 × 키(cm) − 5 × 나이 + 5</li>
      <li>여성: BMR = 10 × 체중(kg) + 6.25 × 키(cm) − 5 × 나이 − 161</li>
    </ul>
  </section>

  <section>
    <h2>활동대사량(TDEE)이란?</h2>
    <p>
      BMR에 활동량을 곱한 값으로, <strong>체중을 유지하는 데 필요한 하루 칼로리</strong>입니다. 실제
      먹어야 하는 양의 기준이 됩니다.
    </p>
    <p>TDEE = BMR × 활동계수</p>
  </section>

  <section>
    <h2>활동량별 계수</h2>
    <table>
      <thead><tr><th>활동 수준</th><th>계수</th></tr></thead>
      <tbody>
        <tr><td>거의 운동 안 함 (좌식)</td><td>1.2</td></tr>
        <tr><td>가벼운 운동 (주 1~3회)</td><td>1.375</td></tr>
        <tr><td>보통 운동 (주 3~5회)</td><td>1.55</td></tr>
        <tr><td>활발한 운동 (주 6~7회)</td><td>1.725</td></tr>
        <tr><td>매우 활발 (육체노동/선수)</td><td>1.9</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>계산 예시</h2>
    <p>남성 30세 · 175cm · 70kg · 좌식 생활:</p>
    <ul>
      <li>BMR = 10 × 70 + 6.25 × 175 − 5 × 30 + 5 = {kcal(ex.bmr)}</li>
      <li>TDEE = BMR × 1.2 = <strong>{kcal(ex.tdee)}</strong> (유지 칼로리)</li>
    </ul>
  </section>

  <section>
    <h2>대표 프로필별 하루 권장 칼로리</h2>
    <p>활동 수준 "보통(주 3~5회 운동)" 기준:</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>프로필</th><th>기초대사량</th><th>유지</th><th>감량</th><th>증량</th></tr>
        </thead>
        <tbody>
          {
            profileRows.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td>{kcal(r.bmr)}</td>
                <td>
                  <strong>{kcal(r.tdee)}</strong>
                </td>
                <td>{kcal(r.loseWeight)}</td>
                <td>{kcal(r.gainWeight)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>결과값 활용</h2>
    <ul>
      <li><strong>유지</strong>: 현재 체중을 유지하려면 이만큼 먹습니다.</li>
      <li><strong>감량</strong>: 유지 − 500kcal. 주 약 0.45kg 감량이 목표입니다.</li>
      <li><strong>증량</strong>: 유지 + 500kcal. 근육 증가를 노린다면 근력 운동을 병행합니다.</li>
    </ul>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      공식에 따른 추정치입니다. 실제 대사량은 근육량·유전·건강 상태에 따라 다릅니다. 체중 조절은
      급격한 칼로리 제한보다 점진적 조정이 안전하며, 필요하면 전문가와 상담하세요.
    </p>
    <p>근거: Mifflin-St Jeor 공식(1990).</p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcBmr, type BmrInput } from '../../lib/bmr';

  const form = document.getElementById('bmr-form') as HTMLFormElement;
  const resultEl = document.getElementById('bmr-result') as HTMLElement;
  const errorEl = document.getElementById('bmr-error') as HTMLElement;
  const kcal = (n: number) => n.toLocaleString('ko-KR') + ' kcal';
  const sel = (id: string) => (document.getElementById(id) as HTMLSelectElement).value;
  const num = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);

  function calculate() {
    try {
      const input: BmrInput = {
        sex: sel('sex') as BmrInput['sex'],
        age: num('age'),
        heightCm: num('height'),
        weightKg: num('weight'),
        activity: sel('activity') as BmrInput['activity'],
      };
      const r = calcBmr(input);
      resultEl.innerHTML = `
        <dl>
          <dt>기초대사량 (BMR)</dt><dd>${kcal(r.bmr)}</dd>
          <dt>유지 칼로리 (TDEE)</dt><dd><strong>${kcal(r.tdee)}</strong></dd>
          <dt>감량 목표</dt><dd>${kcal(r.loseWeight)}</dd>
          <dt>증량 목표</dt><dd>${kcal(r.gainWeight)}</dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
