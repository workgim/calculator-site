---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcAge } from '../../lib/age';

const calculator = getCalculator('age')!;

// 계산 예시 — 기준일을 고정해 빌드마다 값이 흔들리지 않게 함
const beforeBday = calcAge('1995-09-10', '2026-09-08'); // 기준일에 올해 생일이 아직 안 지난 경우
const afterBday = calcAge('1990-03-02', '2026-09-08'); // 생일이 이미 지난 경우

const FAQ = [
  {
    q: '지금 만 나이로 몇 살인가요?',
    a: '올해 연도에서 태어난 해를 뺀 뒤, 올해 생일이 아직 안 지났으면 1을 더 뺍니다. 예를 들어 2026년에 이미 생일이 지난 1990년생은 만 36세, 생일이 안 지났으면 만 35세입니다.',
  },
  {
    q: '만 나이와 연 나이는 어떻게 다른가요?',
    a: '연 나이는 "올해 − 태어난 해"로만 계산해 생일과 무관하게 1월 1일에 한 살씩 오릅니다. 만 나이는 생일을 지나야 한 살이 오릅니다. 생일 전이면 만 나이가 연 나이보다 한 살 적고, 생일 당일·이후에는 둘이 같습니다.',
  },
  {
    q: '빠른 년생은 어떻게 계산하나요?',
    a: '이른바 "빠른 년생"은 옛 학제에서 생긴 입학 시기 구분일 뿐, 나이 계산과는 관계가 없습니다. 만 나이는 실제 생년월일만으로 계산합니다.',
  },
  {
    q: '술·담배 구입 기준 나이는 만 나이인가요?',
    a: '아니요. 청소년 보호법은 "연 나이"를 씁니다. 2026년이면 2007년에 태어난 사람부터 구입할 수 있습니다. 만 나이로 아직 19세가 안 됐어도 그 해에 생일이 오는 사람은 포함됩니다.',
  },
  {
    q: '국제 나이와 같은가요?',
    a: '네. 이 계산기의 만 나이는 국제적으로 통용되는 나이(international age)와 같습니다. 2023년 6월 28일부터 한국의 법령·행정·계약도 이 기준으로 통일됐습니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="age-form">
      <div class="calc-row">
        <div class="calc-field">
          <label for="birth">생년월일</label>
          <input type="date" id="birth" required />
        </div>
        <div class="calc-field">
          <label for="ref">기준일</label>
          <input type="date" id="ref" required />
          <small class="calc-hint">기본값은 오늘</small>
        </div>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="age-result" class="calc-result" hidden></output>
    <p id="age-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>만 나이란?</h2>
    <p>
      <strong>만 나이</strong>는 태어난 날을 0세로 잡고, 생일이 돌아올 때마다 한 살씩 더하는
      나이입니다. 2023년 6월 28일부터 대한민국의 법령·행정·계약에서 나이는 모두 만 나이로
      통일되었고, 국제적으로 쓰는 나이(international age)와 같습니다.
    </p>
  </section>

  <section>
    <h2>만 나이 계산 방법</h2>
    <ul>
      <li>기본: <strong>만 나이 = 기준일 연도 − 출생 연도</strong></li>
      <li>기준일에 <strong>올해 생일이 아직 안 지났으면</strong> 여기서 1을 뺍니다.</li>
    </ul>
    <p>
      생일 당일은 이미 생일이 "지난" 것으로 봐서 그날 한 살이 오릅니다. 이 계산기는 생년월일과
      기준일(기본값 오늘)만 넣으면 자동으로 처리하고, 띠와 다음 생일까지 남은 일수도 함께 보여줍니다.
    </p>
  </section>

  <section>
    <h2>연 나이와 만 나이는 어떻게 다른가요?</h2>
    <p>
      <strong>연 나이</strong>는 "기준일 연도 − 출생 연도"로만 계산합니다. 생일과 상관없이 매년
      1월 1일에 한 살씩 오르며, 병역법·청소년 보호법 등 일부 법률에서 씁니다.
    </p>
    <ul>
      <li>생일 전: 만 나이 = 연 나이 − 1</li>
      <li>생일 당일·이후: 만 나이 = 연 나이</li>
    </ul>
  </section>

  <section>
    <h2>계산 예시</h2>
    <p><strong>생일이 아직 안 지난 경우</strong> — 1995년 9월 10일생, 기준일 2026년 9월 8일:</p>
    <ul>
      <li>연 나이 = 2026 − 1995 = {beforeBday.yearAge}세</li>
      <li>9월 10일 생일이 이틀 남았으므로 1을 빼서 <strong>만 {beforeBday.fullAge}세</strong></li>
      <li>{beforeBday.zodiac}띠 · 다음 생일까지 {beforeBday.daysToNextBirthday}일</li>
    </ul>
    <p><strong>생일이 지난 경우</strong> — 1990년 3월 2일생, 기준일 2026년 9월 8일:</p>
    <ul>
      <li>3월 2일 생일이 이미 지났으므로 <strong>만 {afterBday.fullAge}세</strong> (연 나이와 동일)</li>
      <li>태어난 지 {afterBday.daysLived.toLocaleString()}일</li>
    </ul>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      일부 법률(청소년 보호법의 술·담배 구입 기준, 병역판정검사 등)은 여전히 "연 나이"를 씁니다.
      정확한 적용 기준은 해당 법령을 확인하세요.
    </p>
    <p>근거: 행정기본법·민법(2023-06-28 시행), 국가법령정보센터.</p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcAge } from '../../lib/age';

  const form = document.getElementById('age-form') as HTMLFormElement;
  const birthEl = document.getElementById('birth') as HTMLInputElement;
  const refEl = document.getElementById('ref') as HTMLInputElement;
  const resultEl = document.getElementById('age-result') as HTMLElement;
  const errorEl = document.getElementById('age-error') as HTMLElement;

  refEl.value = new Date().toISOString().slice(0, 10);

  function calculate() {
    try {
      if (!birthEl.value) throw new Error('생년월일을 입력하세요.');
      const r = calcAge(birthEl.value, refEl.value || undefined);
      const bday =
        r.daysToNextBirthday === 0
          ? '오늘이 생일입니다 🎂'
          : `다음 생일까지 <strong>${r.daysToNextBirthday.toLocaleString()}일</strong>`;
      resultEl.innerHTML = `
        <dl>
          <dt>만 나이</dt><dd><strong>만 ${r.fullAge}세</strong></dd>
          <dt>연 나이</dt><dd>${r.yearAge}세</dd>
          <dt>띠</dt><dd>${r.zodiac}띠</dd>
          <dt>태어난 지</dt><dd>${r.daysLived.toLocaleString()}일</dd>
        </dl>
        <p style="margin-top:var(--space-3)">${bday}</p>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
