---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('acquisition-tax')!;
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="at-form">
      <AmountInput
        id="price"
        label="취득가액 (원)"
        placeholder="예: 500000000"
        steps={[10_000_000, 100_000_000, 1_000_000_000]}
      />
      <div class="calc-field">
        <label><input type="checkbox" id="over85" /> 전용면적 85㎡ 초과 (농어촌특별세 대상)</label>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="at-result" class="calc-result" hidden></output>
    <p id="at-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>사용법</h2>
    <p>
      취득가액(매매가)을 입력하세요. <strong>1세대 1주택자가 주택을 유상취득(매매)</strong>하는
      경우의 기본 세율로 계산합니다.
    </p>
  </section>

  <section>
    <h2>세율</h2>
    <table>
      <thead><tr><th>취득가액</th><th>취득세율</th></tr></thead>
      <tbody>
        <tr><td>6억 이하</td><td>1%</td></tr>
        <tr><td>6억 초과 ~ 9억 이하</td><td>1% ~ 3% (가액에 비례)</td></tr>
        <tr><td>9억 초과</td><td>3%</td></tr>
      </tbody>
    </table>
    <ul>
      <li>지방교육세 = 취득가액 × (취득세율 × 50%) × 20%</li>
      <li>농어촌특별세 = 전용면적 85㎡ 초과 시 취득가액 × 0.2% (85㎡ 이하 비과세)</li>
    </ul>
    <p>6~9억 구간 세율(%) = (취득가액(억) × 2 ÷ 3) − 3</p>
  </section>

  <section>
    <h2>주의사항</h2>
    <ul>
      <li><strong>다주택자·법인·조정대상지역 중과</strong>(8%·12% 등)는 반영하지 않습니다.</li>
      <li>증여·상속 취득, 분양권, 오피스텔, 신축(원시취득)은 세율 체계가 다릅니다.</li>
      <li>생애최초 주택 취득세 감면 등 감면 제도는 반영하지 않았습니다.</li>
      <li>정확한 금액은 <strong>위택스(wetax.go.kr)</strong> 또는 관할 시·군·구청에서 확인하세요.</li>
    </ul>
    <p>근거: 지방세법.</p>
  </section>
</CalculatorLayout>

<script>
  import { calcAcquisitionTax } from '../../lib/acquisitionTax';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('at-form') as HTMLFormElement;
  const resultEl = document.getElementById('at-result') as HTMLElement;
  const errorEl = document.getElementById('at-error') as HTMLElement;
  const won = (n: number) => n.toLocaleString('ko-KR') + '원';

  function calculate() {
    try {
      const r = calcAcquisitionTax({
        price: parseAmount((document.getElementById('price') as HTMLInputElement).value),
        over85: (document.getElementById('over85') as HTMLInputElement).checked,
      });
      const rows = [
        `<dt>취득세율</dt><dd>${r.ratePct}%</dd>`,
        `<dt>취득세</dt><dd>${won(r.acquisitionTax)}</dd>`,
        `<dt>지방교육세</dt><dd>${won(r.localEducationTax)}</dd>`,
      ];
      if (r.ruralTax) rows.push(`<dt>농어촌특별세</dt><dd>${won(r.ruralTax)}</dd>`);
      rows.push(`<dt>합계</dt><dd><strong>${won(r.total)}</strong></dd>`);
      resultEl.innerHTML = `<dl>${rows.join('')}</dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
