---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcAcquisitionTax } from '../../lib/acquisitionTax';

const calculator = getCalculator('acquisition-tax')!;

const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const eok = (p: number) => `${(p / 100_000_000).toLocaleString()}억`;
const priceRows = [
  300_000_000, 500_000_000, 600_000_000, 700_000_000, 800_000_000, 900_000_000, 1_000_000_000,
  1_200_000_000,
];
const taxTable = priceRows.map((p) => {
  const under = calcAcquisitionTax({ price: p, over85: false });
  const over = calcAcquisitionTax({ price: p, over85: true });
  return { label: eok(p), ...under, totalUnder: under.total, totalOver: over.total };
});
const ex5 = calcAcquisitionTax({ price: 500_000_000, over85: false });

const FAQ = [
  {
    q: '5억 주택 취득세는 얼마인가요?',
    a: `취득세 ${won(ex5.acquisitionTax)}(세율 1%)에 지방교육세 ${won(ex5.localEducationTax)}를 더해 ${won(ex5.total)}입니다. 전용면적 85㎡ 초과면 농어촌특별세 100만원이 추가됩니다.`,
  },
  {
    q: '6억 초과 9억 이하 세율은 어떻게 계산하나요?',
    a: '세율(%) = (취득가액(억) × 2 ÷ 3) − 3 입니다. 예를 들어 7.5억이면 (7.5 × 2 ÷ 3) − 3 = 2%입니다.',
  },
  {
    q: '생애최초 주택 취득세 감면이 되나요?',
    a: '조건을 충족하면 200만원 한도로 감면됩니다. 이 계산기에는 반영되지 않았으니 별도로 확인하세요.',
  },
  {
    q: '다주택자는 세율이 얼마인가요?',
    a: '조정대상지역 2주택 8%, 3주택 이상·법인 12% 등 중과세율이 적용될 수 있습니다. 이 계산기는 1세대 1주택 기본세율만 계산합니다.',
  },
  {
    q: '취득세는 언제까지 내야 하나요?',
    a: '취득일(보통 잔금일)로부터 60일 이내에 신고·납부해야 합니다. 기한을 넘기면 가산세가 붙습니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="at-form">
      <AmountInput
        id="price"
        label="취득가액 (원)"
        placeholder="예: 500000000"
        steps={[10_000_000, 100_000_000, 1_000_000_000]}
      />
      <div class="calc-field">
        <label><input type="checkbox" id="over85" /> 전용면적 85㎡ 초과 (농어촌특별세 대상)</label>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="at-result" class="calc-result" hidden></output>
    <p id="at-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>취득세란?</h2>
    <p>
      부동산·차량 등을 취득할 때 내는 지방세입니다. 주택은 <strong>취득가액</strong>에 세율(1~3%)을
      곱해 계산하고, 여기에 <strong>지방교육세</strong>와 (전용 85㎡ 초과 시) <strong>농어촌특별세</strong>가
      더해집니다. 이 계산기는 <strong>1세대 1주택 유상취득(매매)</strong> 기준입니다.
    </p>
  </section>

  <section>
    <h2>주택 취득세율</h2>
    <table>
      <thead><tr><th>취득가액</th><th>취득세율</th></tr></thead>
      <tbody>
        <tr><td>6억 이하</td><td>1%</td></tr>
        <tr><td>6억 초과 ~ 9억 이하</td><td>1% ~ 3% (가액에 비례)</td></tr>
        <tr><td>9억 초과</td><td>3%</td></tr>
      </tbody>
    </table>
    <p>6~9억 구간 세율(%) = (취득가액(억) × 2 ÷ 3) − 3</p>
  </section>

  <section>
    <h2>지방교육세·농어촌특별세</h2>
    <ul>
      <li>지방교육세 = 취득가액 × (취득세율 × 50%) × 20% (= 취득세의 10%)</li>
      <li>농어촌특별세 = 전용면적 85㎡ <strong>초과</strong> 시 취득가액 × 0.2% (85㎡ 이하 비과세)</li>
    </ul>
  </section>

  <section>
    <h2>취득가액별 계산 예시</h2>
    <p>1세대 1주택 유상취득 기준:</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>취득가액</th><th>세율</th><th>취득세</th><th>지방교육세</th>
            <th>합계 (85㎡ 이하)</th><th>합계 (85㎡ 초과)</th>
          </tr>
        </thead>
        <tbody>
          {
            taxTable.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td>{r.ratePct}%</td>
                <td>{won(r.acquisitionTax)}</td>
                <td>{won(r.localEducationTax)}</td>
                <td>
                  <strong>{won(r.totalUnder)}</strong>
                </td>
                <td>{won(r.totalOver)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>계산 시 주의사항</h2>
    <ul>
      <li><strong>다주택자·법인·조정대상지역 중과</strong>(8%·12% 등)는 반영하지 않습니다.</li>
      <li>증여·상속 취득, 분양권, 오피스텔, 신축(원시취득)은 세율 체계가 다릅니다.</li>
      <li>생애최초 주택 취득세 감면 등 감면 제도는 반영하지 않았습니다.</li>
      <li>정확한 금액은 <strong>위택스(wetax.go.kr)</strong> 또는 관할 시·군·구청에서 확인하세요.</li>
    </ul>
    <p>근거: 지방세법.</p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcAcquisitionTax } from '../../lib/acquisitionTax';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('at-form') as HTMLFormElement;
  const resultEl = document.getElementById('at-result') as HTMLElement;
  const errorEl = document.getElementById('at-error') as HTMLElement;
  const won = (n: number) => n.toLocaleString('ko-KR') + '원';

  function calculate() {
    try {
      const r = calcAcquisitionTax({
        price: parseAmount((document.getElementById('price') as HTMLInputElement).value),
        over85: (document.getElementById('over85') as HTMLInputElement).checked,
      });
      const rows = [
        `<dt>취득세율</dt><dd>${r.ratePct}%</dd>`,
        `<dt>취득세</dt><dd>${won(r.acquisitionTax)}</dd>`,
        `<dt>지방교육세</dt><dd>${won(r.localEducationTax)}</dd>`,
      ];
      if (r.ruralTax) rows.push(`<dt>농어촌특별세</dt><dd>${won(r.ruralTax)}</dd>`);
      rows.push(`<dt>합계</dt><dd><strong>${won(r.total)}</strong></dd>`);
      resultEl.innerHTML = `<dl>${rows.join('')}</dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
