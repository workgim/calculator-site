---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('char-count')!;

const limitRows = [
  { where: '기업 자기소개서 항목', limit: '500 ~ 1,000자', note: '항목당. 공백 포함이 일반적' },
  { where: '대기업 자소서 (긴 항목)', limit: '1,000 ~ 1,500자', note: '공백 포함' },
  { where: '대학 입학 자기소개서', limit: '1,000 ~ 1,500자', note: '띄어쓰기 포함' },
  { where: '정부·공공기관 지원서', limit: '2,000 ~ 4,000 byte', note: '바이트 제한. EUC-KR 기준인 곳도 있음' },
  { where: '검색 노출용 메타 설명', limit: '약 80 ~ 160자', note: '넘으면 검색결과에서 잘림' },
  { where: 'X(트위터) 게시물', limit: '280자', note: '한글·CJK는 1자를 2로 계산 → 실질 140자' },
  { where: '유튜브 영상 제목', limit: '100자', note: '초과분은 표시되지 않음' },
];

const FAQ = [
  {
    q: '공백도 글자수에 포함되나요?',
    a: '서비스마다 다릅니다. 자기소개서는 대부분 공백 포함으로 세고, 일부 시스템은 공백을 뺍니다. 이 계산기는 공백 포함·제외를 함께 보여주니 둘 다 확인하세요.',
  },
  {
    q: '자소서 "1,000자"는 공백 포함인가요?',
    a: '명시가 없으면 공백(띄어쓰기) 포함으로 보는 것이 안전합니다. 채용 시스템이 붙여넣기 시점에 공백 포함으로 카운트하는 경우가 많고, 줄바꿈도 보통 1자로 셉니다.',
  },
  {
    q: 'UTF-8과 EUC-KR 바이트 중 뭘 봐야 하나요?',
    a: '요즘 웹 서비스 대부분은 UTF-8(한글 3바이트)입니다. 오래된 공공기관 게시판이나 "2,000바이트" 같은 제한은 EUC-KR(한글 2바이트)일 수 있으니 안내 문구를 확인하세요.',
  },
  {
    q: '이모지는 몇 글자로 세나요?',
    a: '이 계산기는 이모지를 코드포인트 기준 1자로 셉니다. 바이트로는 UTF-8에서 보통 4바이트이고, 피부색·가족 이모지처럼 여러 코드포인트가 합쳐진 것은 더 크게 잡힐 수 있습니다.',
  },
  {
    q: '줄바꿈도 글자수에 들어가나요?',
    a: '"공백 포함" 글자 수에는 줄바꿈이 포함되고, "공백 제외"에서는 빠집니다. 채용 사이트도 대개 줄바꿈을 1자로 셉니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <div class="calc-field">
      <label for="text">텍스트 입력</label>
      <textarea id="text" rows="8" placeholder="여기에 글을 붙여넣거나 입력하세요"></textarea>
    </div>
    <output id="cc-result" class="calc-result"></output>
  </section>

  <section>
    <h2>글자 수 세는 방법</h2>
    <p>
      화면에 보이는 글자 하나를 1자로 셉니다(코드포인트 단위). 입력하거나 붙여넣는 즉시 공백
      포함·제외 글자 수, UTF-8·EUC-KR 바이트, 단어 수, 줄 수가 갱신됩니다.
    </p>
  </section>

  <section>
    <h2>공백 포함 / 공백 제외 글자 수</h2>
    <ul>
      <li><strong>공백 포함</strong>: 띄어쓰기·줄바꿈·탭을 모두 1자로 셉니다. 자기소개서는 보통 이 기준입니다.</li>
      <li><strong>공백 제외</strong>: 모든 공백 문자를 뺀 순수 글자 수입니다.</li>
    </ul>
    <p>예를 들어 "안녕 하세요"는 공백 포함 6자, 공백 제외 5자입니다.</p>
  </section>

  <section>
    <h2>UTF-8 바이트 vs EUC-KR 바이트</h2>
    <ul>
      <li><strong>UTF-8</strong>: 한글 1자 = 3바이트, 영문·숫자·기본 기호 = 1바이트. 요즘 웹 서비스 대부분.</li>
      <li><strong>EUC-KR</strong>: 한글 1자 = 2바이트, 영문·숫자 = 1바이트. 일부 공공기관 게시판·구형 시스템.</li>
    </ul>
    <p>"바이트" 제한이 있는 곳은 어느 인코딩 기준인지 안내를 꼭 확인하세요.</p>
  </section>

  <section>
    <h2>자기소개서 글자 수 확인</h2>
    <p>자주 쓰이는 제한을 정리했습니다. 참고용이며, 실제 기준은 지원하는 곳의 공고를 확인하세요.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>어디</th><th>대략적인 제한</th><th>비고</th></tr></thead>
        <tbody>
          {limitRows.map((r) => (
            <tr><td>{r.where}</td><td><strong>{r.limit}</strong></td><td>{r.note}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>블로그·게시판 글자 수</h2>
    <p>
      블로그 본문은 글자 수 제한이 거의 없지만, 검색 노출용 <strong>메타 설명</strong>은 80~160자
      정도만 표시됩니다. 게시판·댓글은 서비스마다 100~2,000자 또는 바이트로 제한합니다. 단어 수와
      줄 수는 글의 분량을 가늠할 때 참고하세요.
    </p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { countChars } from '../../lib/charCount';

  const textEl = document.getElementById('text') as HTMLTextAreaElement;
  const resultEl = document.getElementById('cc-result') as HTMLElement;
  const fmt = (n: number) => n.toLocaleString('ko-KR');

  function render() {
    const c = countChars(textEl.value);
    resultEl.innerHTML = `
      <dl>
        <dt>글자 수 (공백 포함)</dt><dd><strong>${fmt(c.charsWithSpaces)}</strong></dd>
        <dt>글자 수 (공백 제외)</dt><dd>${fmt(c.charsWithoutSpaces)}</dd>
        <dt>바이트 (UTF-8)</dt><dd>${fmt(c.bytesUtf8)}</dd>
        <dt>바이트 (EUC-KR)</dt><dd>${fmt(c.bytesEucKr)}</dd>
        <dt>단어 수</dt><dd>${fmt(c.words)}</dd>
        <dt>줄 수</dt><dd>${fmt(c.lines)}</dd>
      </dl>`;
  }

  textEl.addEventListener('input', render);
  render();
</script>

<style>
  textarea {
    width: 100%;
    min-height: 10rem;
    padding: var(--space-3);
    font: inherit;
    font-size: var(--fs-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
  }
  textarea:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
</style>
