---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcSalary } from '../../lib/salary';

const calculator = getCalculator('salary-net')!;

// "자주 찾는 값" 표 — 기본 조건(비과세 월 20만원, 부양가족 1명)으로 lib 에서 직접 계산
const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const SALARY_ROWS = [
  24_000_000, 26_000_000, 28_000_000, 30_000_000, 32_000_000, 34_000_000, 36_000_000, 38_000_000,
  40_000_000, 45_000_000, 50_000_000, 60_000_000, 70_000_000, 80_000_000, 100_000_000, 120_000_000,
  150_000_000,
];
const salaryTable = SALARY_ROWS.map((annual) => {
  const r = calcSalary({ annualSalary: annual });
  return {
    annual,
    monthlyGross: r.monthlyGross,
    insurance: r.nationalPension + r.healthInsurance + r.longTermCare + r.employmentInsurance,
    tax: r.incomeTax + r.localIncomeTax,
    monthlyNet: r.monthlyNet,
    annualNet: r.annualNet,
  };
});
const ex40 = calcSalary({ annualSalary: 40_000_000 });
const net30 = salaryTable.find((r) => r.annual === 30_000_000)!.monthlyNet;
const net50 = salaryTable.find((r) => r.annual === 50_000_000)!.monthlyNet;

const FAQ = [
  {
    q: '연봉 3,000만원이면 월급은 얼마인가요?',
    a: `세전 월 급여는 250만원이지만, 4대보험과 세금을 공제한 월 실수령액은 약 ${won(net30)}입니다. 비과세액과 부양가족 수에 따라 달라집니다.`,
  },
  {
    q: '연봉 4,000만원 실수령액은 얼마인가요?',
    a: `기본 조건(비과세 월 20만원, 부양가족 1명)에서 월 약 ${won(ex40.monthlyNet)}, 연 약 ${won(ex40.annualNet)}입니다.`,
  },
  {
    q: '연봉 5,000만원이면 월 실수령액은?',
    a: `약 ${won(net50)}입니다. 아래 연봉별 실수령액 표에서 다른 연봉도 확인할 수 있습니다.`,
  },
  {
    q: '부양가족이 있으면 실수령액이 달라지나요?',
    a: '부양가족 1명당 연 150만원의 인적공제가 적용되어 소득세가 줄고 실수령액이 늘어납니다. 8~20세 자녀가 있으면 자녀 세액공제가 추가됩니다.',
  },
  {
    q: '비과세 급여가 있으면 실수령액이 어떻게 달라지나요?',
    a: '비과세액(식대 등, 월 20만원까지)은 4대보험료와 소득세 부과 대상에서 빠집니다. 비과세액이 클수록 공제가 줄어 실수령액이 늘어납니다.',
  },
  {
    q: '이 계산기 결과와 실제 급여명세서가 다른 이유는?',
    a: '실제 매월 원천징수 세액은 국세청 간이세액표를 따르고, 회사마다 상여금 지급 방식·수당 구성이 다릅니다. 최종 세금은 이듬해 연말정산에서 정산됩니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="salary-form">
      <AmountInput
        id="annual"
        label="연봉 (원, 세전)"
        placeholder="예: 36000000"
        steps={[1_000_000, 10_000_000, 100_000_000]}
      />
      <div class="calc-row">
        <AmountInput
          id="nontax"
          label="월 비과세액 (원)"
          hint="식대 등. 기본 20만원"
          value={200000}
          required={false}
          steps={[50_000, 100_000]}
        />
        <div class="calc-field">
          <label for="dependents">부양가족 수</label>
          <input type="number" id="dependents" inputmode="numeric" step="1" min="1" value="1" />
          <small class="calc-hint">본인 포함</small>
        </div>
      </div>
      <div class="calc-row">
        <div class="calc-field">
          <label for="children">8~20세 자녀 수</label>
          <input type="number" id="children" inputmode="numeric" step="1" min="0" value="0" />
          <small class="calc-hint">자녀 세액공제용</small>
        </div>
        <div class="calc-field">
          <label for="withholding">원천징수 비율</label>
          <select id="withholding">
            <option value="0.8">80%</option>
            <option value="1" selected>100% (기본)</option>
            <option value="1.2">120%</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="salary-result" class="calc-result" hidden></output>
    <p id="salary-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>이 계산기는 무엇을 계산하나요?</h2>
    <p>
      세전 연봉에서 <strong>국민연금·건강보험·장기요양보험·고용보험(4대보험)</strong>과
      <strong>근로소득세·지방소득세</strong>를 공제한 뒤 실제로 통장에 들어오는 월 실수령액과 연
      실수령액을 계산합니다. 비과세액, 부양가족 수, 8~20세 자녀 수, 원천징수 비율을 조정할 수
      있습니다.
    </p>
  </section>

  <section>
    <h2>계산에 사용되는 용어</h2>
    <dl class="terms">
      <dt>연봉</dt><dd>1년 동안 받는 세전 급여 총액. 상여금·수당이 포함되기도 합니다.</dd>
      <dt>월 급여</dt><dd>연봉 ÷ 12. 여기서 각종 공제를 빼면 실수령액이 됩니다.</dd>
      <dt>비과세액</dt><dd>세금·보험료가 매겨지지 않는 급여(식대 등, 월 20만원까지). 공제 대상 소득에서 제외됩니다.</dd>
      <dt>국민연금</dt><dd>노후 연금 재원. 근로자는 기준소득월액의 4.75%(2026년).</dd>
      <dt>건강보험</dt><dd>의료비 보장 재원. 근로자는 보수월액의 3.595%(2026년).</dd>
      <dt>장기요양보험</dt><dd>노인 요양 재원. 건강보험료의 13.14%(2026년).</dd>
      <dt>고용보험</dt><dd>실업급여 등 재원. 근로자는 0.9%.</dd>
      <dt>근로소득세</dt><dd>급여에 매기는 국세. 매월은 국세청 간이세액표로 미리 떼고 연말정산에서 정산합니다.</dd>
      <dt>지방소득세</dt><dd>근로소득세의 10%를 지방자치단체에 냅니다.</dd>
    </dl>
  </section>

  <section>
    <h2>연봉 실수령액은 어떻게 계산하나요?</h2>
    <p>월 과세소득(월 급여 − 비과세액)에 아래 요율을 적용해 4대보험료를 공제합니다.</p>
    <table>
      <thead>
        <tr><th>항목</th><th>근로자 부담</th><th>부과 기준</th></tr>
      </thead>
      <tbody>
        <tr><td>국민연금</td><td>4.75%</td><td>기준소득월액(상한 637만·하한 40만)</td></tr>
        <tr><td>건강보험</td><td>3.595%</td><td>월 과세소득</td></tr>
        <tr><td>장기요양보험</td><td>건강보험료 × 13.14%</td><td>—</td></tr>
        <tr><td>고용보험</td><td>0.9%</td><td>월 과세소득</td></tr>
        <tr><td>지방소득세</td><td>근로소득세 × 10%</td><td>—</td></tr>
      </tbody>
    </table>
    <p>
      근로소득세는 국세청 <strong>근로소득 간이세액표</strong>를 따릅니다. 이 계산기는 표를 그대로
      쓰지 않고 연간 세액을 구해 12로 나눈 <strong>근사값</strong>을 씁니다.
    </p>
    <ol>
      <li>연 과세대상 총급여 = 연봉 − (월 비과세액 × 12)</li>
      <li>근로소득공제를 빼서 근로소득금액 산출</li>
      <li>인적공제(부양가족 1인당 150만원)·국민연금 보험료 공제를 빼서 과세표준 산출</li>
      <li>종합소득세율(6~45%, 누진공제) 적용 → 산출세액</li>
      <li>근로소득세액공제, 8~20세 자녀 세액공제를 빼서 결정세액</li>
      <li>결정세액 ÷ 12 × 원천징수 비율 = 월 근로소득세</li>
    </ol>
  </section>

  <section>
    <h2>연봉과 월급의 차이</h2>
    <p>
      연봉 4,000만원이라고 해서 월 실수령액이 333만원인 것은 아닙니다. 333만원은 <strong>세전</strong>
      월 급여이고, 여기서 4대보험료와 세금이 빠집니다. 기본 조건에서 연봉 4,000만원의 월 실수령액은
      약 <strong>{won(ex40.monthlyNet)}</strong>입니다.
    </p>
  </section>

  <section>
    <h2>계산 예시</h2>
    <p>연봉 4,000만원 · 월 비과세액 20만원 · 부양가족 1명(본인) 기준:</p>
    <ul>
      <li>월 세전 급여 {won(ex40.monthlyGross)}</li>
      <li>국민연금 −{won(ex40.nationalPension)} / 건강보험 −{won(ex40.healthInsurance)} / 장기요양 −{won(ex40.longTermCare)} / 고용보험 −{won(ex40.employmentInsurance)}</li>
      <li>근로소득세 −{won(ex40.incomeTax)} / 지방소득세 −{won(ex40.localIncomeTax)}</li>
      <li><strong>월 실수령액 약 {won(ex40.monthlyNet)}</strong> (연 {won(ex40.annualNet)})</li>
    </ul>
  </section>

  <section>
    <h2>2026년 연봉별 실수령액</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>연봉</th><th>월 세전</th><th>4대보험</th><th>세금</th><th>월 실수령액</th><th>연 실수령액</th>
          </tr>
        </thead>
        <tbody>
          {
            salaryTable.map((r) => (
              <tr>
                <td>{(r.annual / 10000).toLocaleString()}만원</td>
                <td>{won(r.monthlyGross)}</td>
                <td>{won(r.insurance)}</td>
                <td>{won(r.tax)}</td>
                <td>
                  <strong>{won(r.monthlyNet)}</strong>
                </td>
                <td>{won(r.annualNet)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="calc-hint">
      기본 조건(비과세 월 20만원, 부양가족 1명, 원천징수 100%) 기준입니다. 위 계산기에서 조건을
      바꿔 계산하세요.
    </p>
  </section>

  <section>
    <h2>주의사항</h2>
    <ul>
      <li>
        <strong>예상치입니다.</strong> 실제 원천징수는 간이세액표를 따르며, 연말정산에서 각종
        공제(신용카드·의료비·기부금 등)를 반영해 최종 정산됩니다.
      </li>
      <li>비과세 항목, 상여금 지급 방식, 회사 규정에 따라 실수령액이 달라질 수 있습니다.</li>
      <li>요율은 <strong>2026년 기준</strong>입니다. 4대보험 요율은 매년 1월, 국민연금 기준소득월액은 매년 7월에 바뀝니다.</li>
    </ul>
    <p>
      근거: 국민연금공단, 국민건강보험공단, 보건복지부 2026년 고시, 고용노동부, 국세청 근로소득
      간이세액표(nts.go.kr), 소득세법.
    </p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcSalary, type SalaryInput } from '../../lib/salary';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('salary-form') as HTMLFormElement;
  const resultEl = document.getElementById('salary-result') as HTMLElement;
  const errorEl = document.getElementById('salary-error') as HTMLElement;
  const won = (n: number) => n.toLocaleString('ko-KR') + '원';
  const numVal = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);
  const amountVal = (id: string) =>
    parseAmount((document.getElementById(id) as HTMLInputElement).value);

  function calculate() {
    try {
      const input: SalaryInput = {
        annualSalary: amountVal('annual'),
        monthlyNonTax: amountVal('nontax') || 0,
        dependents: numVal('dependents'),
        childrenForCredit: numVal('children') || 0,
        withholdingRate: parseFloat((document.getElementById('withholding') as HTMLSelectElement).value),
      };
      const r = calcSalary(input);
      resultEl.innerHTML = `
        <dl>
          <dt>월 세전 급여</dt><dd>${won(r.monthlyGross)}</dd>
          <dt>국민연금</dt><dd>− ${won(r.nationalPension)}</dd>
          <dt>건강보험</dt><dd>− ${won(r.healthInsurance)}</dd>
          <dt>장기요양보험</dt><dd>− ${won(r.longTermCare)}</dd>
          <dt>고용보험</dt><dd>− ${won(r.employmentInsurance)}</dd>
          <dt>근로소득세</dt><dd>− ${won(r.incomeTax)}</dd>
          <dt>지방소득세</dt><dd>− ${won(r.localIncomeTax)}</dd>
          <dt>공제 합계</dt><dd>− ${won(r.totalDeduction)}</dd>
          <dt>월 실수령액</dt><dd><strong>${won(r.monthlyNet)}</strong></dd>
          <dt>연 실수령액</dt><dd>${won(r.annualNet)}</dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form?.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
