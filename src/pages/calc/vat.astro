---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcVat } from '../../lib/vat';

const calculator = getCalculator('vat')!;

const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const supplyRows = [
  10_000, 50_000, 100_000, 300_000, 500_000, 1_000_000, 3_000_000, 5_000_000, 10_000_000, 50_000_000,
].map((a) => calcVat(a, 'supply'));
const totalRows = [11_000, 55_000, 110_000, 1_100_000, 11_000_000].map((a) => calcVat(a, 'total'));

const FAQ = [
  {
    q: '부가세 포함 금액에서 공급가액을 어떻게 구하나요?',
    a: '합계금액 ÷ 1.1 이 공급가액이고, 합계 − 공급가액이 부가세입니다. 예를 들어 110만원이 부가세 포함이면 공급가액 100만원, 부가세 10만원입니다.',
  },
  {
    q: '110만원의 부가세는 얼마인가요?',
    a: '110만원이 부가세 포함 합계라면 부가세는 10만원입니다. 110만원이 공급가액(부가세 별도)이라면 부가세는 11만원, 합계는 121만원입니다.',
  },
  {
    q: '간이과세자도 10%인가요?',
    a: '간이과세자는 업종별 부가가치율을 곱한 낮은 실효세율이 적용됩니다. 이 계산기는 일반과세 10% 기준입니다.',
  },
  {
    q: '면세 상품에도 부가세가 붙나요?',
    a: '아닙니다. 기초 생필품, 의료·교육 서비스 등 면세 대상에는 부가세가 붙지 않습니다.',
  },
  {
    q: '세금계산서 금액과 1원 차이가 나는 이유는?',
    a: '역산 과정의 원 단위 반올림 차이입니다. 세금계산서 작성 시에는 국세청·회계 기준을 따르세요.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="vat-form">
      <div class="calc-field">
        <label for="basis">입력 금액의 종류</label>
        <select id="basis">
          <option value="supply">공급가액 (부가세 별도 금액)</option>
          <option value="total">합계금액 (부가세 포함 금액)</option>
          <option value="vat">부가세액</option>
        </select>
      </div>
      <AmountInput id="amount" label="금액 (원)" placeholder="예: 1000000" />
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="vat-result" class="calc-result" hidden></output>
    <p id="vat-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>부가세란 무엇인가요?</h2>
    <p>
      부가가치세(VAT)는 상품·서비스가 거래될 때 붙는 세금입니다. 대한민국의 일반 세율은
      <strong>10%</strong>이며, 사업자가 소비자에게서 받아 국세청에 냅니다. (간이과세·면세 사업자는
      적용이 다릅니다.)
    </p>
  </section>

  <section>
    <h2>공급가액 · 부가세액 · 합계금액</h2>
    <dl class="terms">
      <dt>공급가액</dt><dd>부가세를 뺀 물건·서비스 자체의 값 (부가세 별도 금액).</dd>
      <dt>부가세액</dt><dd>공급가액의 10%.</dd>
      <dt>합계금액</dt><dd>공급가액 + 부가세액. 소비자가 실제로 내는 금액 (부가세 포함 금액).</dd>
    </dl>
  </section>

  <section>
    <h2>부가세 별도 금액 계산</h2>
    <ul>
      <li>부가세액 = 공급가액 × 10%</li>
      <li>합계금액 = 공급가액 × 1.1</li>
    </ul>
    <p>공급가액이 1,000,000원이면 부가세 100,000원, 합계 1,100,000원입니다.</p>
  </section>

  <section>
    <h2>부가세 역산 (포함 → 별도)</h2>
    <ul>
      <li>공급가액 = 합계금액 ÷ 1.1</li>
      <li>부가세액 = 합계금액 − 공급가액</li>
    </ul>
    <p>110만원이 부가세 포함 금액이라면 공급가액은 1,000,000원, 부가세는 100,000원입니다.</p>
  </section>

  <section>
    <h2>계산 예시</h2>
    <ul>
      <li>공급가액 500,000원 → 부가세 50,000원 → 합계 550,000원</li>
      <li>합계 330,000원 → 공급가액 300,000원 + 부가세 30,000원</li>
    </ul>
  </section>

  <section>
    <h2>금액별 부가세</h2>
    <p>공급가액(부가세 별도) 기준:</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>공급가액</th><th>부가세 (10%)</th><th>합계금액</th></tr>
        </thead>
        <tbody>
          {
            supplyRows.map((r) => (
              <tr>
                <td>{won(r.supply)}</td>
                <td>{won(r.vat)}</td>
                <td>
                  <strong>{won(r.total)}</strong>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>합계금액(부가세 포함) 기준:</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>합계금액</th><th>공급가액</th><th>부가세</th></tr>
        </thead>
        <tbody>
          {
            totalRows.map((r) => (
              <tr>
                <td>{won(r.total)}</td>
                <td>
                  <strong>{won(r.supply)}</strong>
                </td>
                <td>{won(r.vat)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      역산 과정에서 원 단위 반올림으로 1원 정도 차이가 날 수 있습니다. 세금계산서 작성 시에는
      국세청 기준을 따르세요.
    </p>
    <p>근거: 국세청 부가가치세 안내 (nts.go.kr).</p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcVat, type VatBasis } from '../../lib/vat';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('vat-form') as HTMLFormElement;
  const basisEl = document.getElementById('basis') as HTMLSelectElement;
  const amountEl = document.getElementById('amount') as HTMLInputElement;
  const resultEl = document.getElementById('vat-result') as HTMLElement;
  const errorEl = document.getElementById('vat-error') as HTMLElement;

  const won = (n: number) => n.toLocaleString('ko-KR') + '원';

  function calculate() {
    try {
      const { supply, vat, total } = calcVat(parseAmount(amountEl.value), basisEl.value as VatBasis);
      resultEl.innerHTML = `
        <dl>
          <dt>공급가액</dt><dd>${won(supply)}</dd>
          <dt>부가세액</dt><dd>${won(vat)}</dd>
          <dt>합계금액</dt><dd><strong>${won(total)}</strong></dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form?.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
