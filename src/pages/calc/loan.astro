---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { calcLoan, type RepaymentType } from '../../lib/loan';

const calculator = getCalculator('loan')!;

const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const METHODS: { key: RepaymentType; name: string }[] = [
  { key: 'equalPayment', name: '원리금균등' },
  { key: 'equalPrincipal', name: '원금균등' },
  { key: 'bullet', name: '만기일시' },
];
// 상환방식 비교: 1억 / 연 5% / 360개월(30년)
const compare = METHODS.map((m) => ({ name: m.name, ...calcLoan(100_000_000, 5, 360, m.key) }));
// 대출금액별: 연 4.5% / 360개월 / 원리금균등
const byAmount = [50_000_000, 100_000_000, 200_000_000, 300_000_000].map((p) => ({
  p,
  ...calcLoan(p, 4.5, 360, 'equalPayment'),
}));
const int1e = byAmount.find((r) => r.p === 100_000_000)!.totalInterest;

const FAQ = [
  {
    q: '원리금균등과 원금균등 중 어느 게 유리한가요?',
    a: '총 이자만 보면 원금균등이 적습니다. 대신 초기 상환 부담이 큽니다. 매달 같은 금액이 편하면 원리금균등을 선택합니다.',
  },
  {
    q: '대출 1억을 30년 갚으면 이자는 얼마인가요?',
    a: `연 4.5% · 원리금균등 기준 총 이자는 약 ${won(int1e)}입니다. 금리와 기간에 따라 크게 달라집니다.`,
  },
  {
    q: '중도상환하면 이자가 줄어드나요?',
    a: '네. 남은 원금이 줄면 이후 붙는 이자도 줄어듭니다. 다만 대출에 따라 중도상환수수료가 있을 수 있습니다.',
  },
  {
    q: '거치기간을 두면 왜 총 이자가 늘어나나요?',
    a: '거치기간 동안 원금이 그대로 남아 그만큼 이자가 더 붙고, 원금을 갚는 기간도 짧아져 매달 부담이 커집니다.',
  },
  {
    q: '실제 은행 계산기와 몇 원 차이가 나는 이유는?',
    a: '이자 계산 기준일(일할), 반올림 방식, 첫 회차 조정 방식이 은행마다 달라 수십 원 정도 차이가 날 수 있습니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="loan-form">
      <AmountInput
        id="principal"
        label="대출 원금 (원)"
        placeholder="예: 30000000"
        steps={[1_000_000, 10_000_000, 100_000_000]}
      />
      <div class="calc-row">
        <div class="calc-field">
          <label for="rate">연이자율 (%)</label>
          <input type="number" id="rate" inputmode="decimal" step="0.01" min="0" placeholder="예: 4.5" required />
          <div class="stepper">
            <button type="button" data-step="0.1" data-target="rate">+0.1</button>
            <button type="button" data-step="0.5" data-target="rate">+0.5</button>
            <button type="button" data-step="1" data-target="rate">+1</button>
            <button type="button" data-step="clear" data-target="rate" class="stepper__clear" aria-label="지우기">C</button>
          </div>
        </div>
        <div class="calc-field">
          <label for="months">전체 기간 (개월)</label>
          <input type="number" id="months" inputmode="numeric" step="1" min="1" max="600" placeholder="예: 36" required />
          <div class="stepper">
            <button type="button" data-step="1" data-target="months">+1</button>
            <button type="button" data-step="12" data-target="months">+12</button>
            <button type="button" data-step="60" data-target="months">+60</button>
            <button type="button" data-step="clear" data-target="months" class="stepper__clear" aria-label="지우기">C</button>
          </div>
        </div>
      </div>
      <div class="calc-field">
        <label for="type">상환 방식</label>
        <select id="type">
          <option value="equalPayment">원리금균등상환</option>
          <option value="equalPrincipal">원금균등상환</option>
          <option value="bullet">만기일시상환</option>
        </select>
      </div>
      <div class="calc-field" id="grace-field">
        <label for="grace">거치기간 (개월)</label>
        <input type="number" id="grace" inputmode="numeric" step="1" min="0" max="599" value="0" />
        <div class="stepper">
          <button type="button" data-step="6" data-target="grace">+6</button>
          <button type="button" data-step="12" data-target="grace">+12</button>
          <button type="button" data-step="clear" data-target="grace" class="stepper__clear" aria-label="지우기">C</button>
        </div>
        <small class="calc-hint">
          거치기간 동안은 이자만 냅니다. 남은 기간(전체 − 거치)에 원금을 상환합니다. 없으면 0.
        </small>
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="loan-result" class="calc-result" hidden></output>
    <p id="loan-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>대출 이자는 어떻게 계산되나요?</h2>
    <p>
      월 이자율 = 연이자율 ÷ 12 로 두고, 매달 <strong>남은 원금</strong>에 월 이자율을 곱해 이자가
      붙습니다. 원금을 어떻게 나눠 갚느냐(상환 방식)에 따라 월 상환액과 총 이자가 달라집니다.
    </p>
  </section>

  <section>
    <h2>원리금균등상환</h2>
    <p>
      매달 갚는 금액(원금 + 이자)이 <strong>같습니다.</strong> 초반에는 이자 비중이 크고 갈수록 원금
      비중이 커집니다. 가장 일반적인 방식입니다.
    </p>
    <p>월 상환액 = 원금 × 월이자율 × (1+월이자율)^개월 ÷ ((1+월이자율)^개월 − 1)</p>
  </section>

  <section>
    <h2>원금균등상환</h2>
    <p>
      매달 갚는 <strong>원금이 같고</strong>, 이자는 남은 원금에 붙어 점점 줄어듭니다. 초기 부담이
      크지만 <strong>총 이자는 세 방식 중 가장 적습니다.</strong>
    </p>
    <p>매달 원금 = 원금 ÷ 개월, 이자 = 남은 원금 × 월이자율</p>
  </section>

  <section>
    <h2>만기일시상환</h2>
    <p>
      기간 동안 <strong>이자만</strong> 내고 원금은 만기에 한 번에 갚습니다. 원금이 끝까지 줄지 않아
      <strong>총 이자가 가장 많습니다.</strong> (구조상 전체가 거치이므로 거치기간 입력은 무시됩니다.)
    </p>
  </section>

  <section>
    <h2>거치기간이란?</h2>
    <p>
      원금 상환을 미루고 이자만 내는 기간입니다. 예를 들어 36개월 대출에 거치 12개월을 두면, 처음
      12개월은 원금 전액에 대한 이자만 내고 남은 24개월에 원금을 나눠 갚습니다. 초기 부담은 줄지만
      원금이 늦게 줄어 <strong>총 이자는 늘어납니다.</strong>
    </p>
  </section>

  <section>
    <h2>계산 예시</h2>
    <p>대출 1억원 · 연 5% · 30년(360개월):</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>상환 방식</th><th>첫 달 상환액</th><th>총 이자</th><th>총 상환액</th></tr>
        </thead>
        <tbody>
          {
            compare.map((r) => (
              <tr>
                <td>{r.name}</td>
                <td>{won(r.firstPayment)}</td>
                <td>
                  <strong>{won(r.totalInterest)}</strong>
                </td>
                <td>{won(r.totalPayment)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="calc-hint">원금균등은 첫 달이 가장 크고 매달 조금씩 줄어듭니다.</p>
  </section>

  <section>
    <h2>대출금액별 월 상환액</h2>
    <p>연 4.5% · 30년(360개월) · 원리금균등 기준:</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>대출 원금</th><th>월 상환액</th><th>총 이자</th><th>총 상환액</th></tr>
        </thead>
        <tbody>
          {
            byAmount.map((r) => (
              <tr>
                <td>{won(r.p)}</td>
                <td>
                  <strong>{won(r.monthlyPayment ?? r.firstPayment)}</strong>
                </td>
                <td>{won(r.totalInterest)}</td>
                <td>{won(r.totalPayment)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      실제 대출은 중도상환수수료, 이자 계산 기준일(일할), 우대금리 조건, 상환 첫 회차 조정 등에 따라
      결과가 달라질 수 있습니다. 이 계산기는 표준 상환식에 따른 개략값입니다.
    </p>
    <p>근거: 금융감독원 금융소비자포털 '파인' 금융계산기 (fine.fss.or.kr).</p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { calcLoan, type RepaymentType } from '../../lib/loan';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('loan-form') as HTMLFormElement;
  const resultEl = document.getElementById('loan-result') as HTMLElement;
  const errorEl = document.getElementById('loan-error') as HTMLElement;
  const typeEl = document.getElementById('type') as HTMLSelectElement;
  const graceField = document.getElementById('grace-field') as HTMLElement;
  const won = (n: number) => n.toLocaleString('ko-KR') + '원';
  const val = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);

  function syncGraceField() {
    graceField.hidden = typeEl.value === 'bullet';
  }
  typeEl?.addEventListener('change', syncGraceField);
  syncGraceField();

  function calculate() {
    try {
      const type = typeEl.value as RepaymentType;
      const grace = type === 'bullet' ? 0 : val('grace') || 0;
      const principal = parseAmount(
        (document.getElementById('principal') as HTMLInputElement).value,
      );
      const res = calcLoan(principal, val('rate'), val('months'), type, grace);

      const rows: string[] = [];
      if (res.gracePayment !== null) {
        rows.push(
          `<dt>거치기간 중 매월<br><small>${res.graceMonths}개월, 이자만</small></dt><dd>${won(res.gracePayment)}</dd>`,
        );
      }
      if (res.monthlyPayment !== null) {
        const label = res.graceMonths > 0 ? '거치 후 매월 상환액' : '매월 상환액';
        rows.push(`<dt>${label}</dt><dd><strong>${won(res.monthlyPayment)}</strong></dd>`);
      } else {
        const prefix = res.graceMonths > 0 ? '거치 후 ' : '';
        rows.push(`<dt>${prefix}첫 달 상환액</dt><dd>${won(res.firstPayment)}</dd>`);
        rows.push(`<dt>마지막 달 상환액</dt><dd>${won(res.lastPayment)}</dd>`);
      }
      rows.push(`<dt>총 이자</dt><dd>${won(res.totalInterest)}</dd>`);
      rows.push(`<dt>총 상환액</dt><dd>${won(res.totalPayment)}</dd>`);
      resultEl.innerHTML = `<dl>${rows.join('')}</dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form?.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
