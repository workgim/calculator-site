---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Faq from '../../components/Faq.astro';
import { getCalculator } from '../../data/calculators';
import { pyeongToSqm, sqmToPyeong } from '../../lib/pyeong';

const calculator = getCalculator('pyeong')!;

const sqmToP = [33, 40, 49, 59, 74, 84, 101, 114, 134].map((s) => ({ s, p: sqmToPyeong(s) }));
const pToSqm = [10, 15, 18, 24, 25, 32, 34, 45, 59].map((p) => ({ p, s: pyeongToSqm(p) }));

const FAQ = [
  { q: '84㎡는 몇 평인가요?', a: `약 ${sqmToPyeong(84)}평입니다. 국민주택 규모(85㎡)와 비슷한 면적입니다.` },
  { q: '59㎡는 몇 평인가요?', a: `약 ${sqmToPyeong(59)}평입니다.` },
  { q: '25평은 몇 ㎡인가요?', a: `약 ${pyeongToSqm(25)}㎡입니다.` },
  {
    q: '국민주택 규모 85㎡는 몇 평인가요?',
    a: `약 ${sqmToPyeong(85)}평입니다. 주택청약·세제에서 기준이 되는 면적입니다.`,
  },
  {
    q: '공급면적과 전용면적은 어떻게 다른가요?',
    a: '전용면적은 세대가 독립적으로 쓰는 실내 면적이고, 공급면적은 전용면적에 계단·복도 등 주거공용면적을 더한 것입니다. 아파트 "34평"은 보통 공급면적 기준이라 전용면적은 그보다 작습니다.',
  },
];
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="py-form">
      <div class="calc-row">
        <div class="calc-field">
          <label for="value">값</label>
          <input type="number" id="value" inputmode="decimal" step="any" min="0" placeholder="예: 34" required />
        </div>
        <div class="calc-field">
          <label for="unit">단위</label>
          <select id="unit">
            <option value="pyeong">평</option>
            <option value="sqm">제곱미터(㎡)</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn">변환</button>
    </form>

    <output id="py-result" class="calc-result" hidden></output>
    <p id="py-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>1평은 몇 ㎡인가요?</h2>
    <p>
      <strong>1평 = 400 ÷ 121 ㎡ ≈ 3.3058㎡</strong>입니다. 반대로 <strong>1㎡ ≈ 0.3025평</strong>
      입니다. 평은 법정 계량 단위가 아니지만 부동산에서 관습적으로 쓰입니다.
    </p>
  </section>

  <section>
    <h2>평 → 제곱미터 변환 방법</h2>
    <p>제곱미터 = 평 × 3.3058</p>
    <p>예: 34평 × 3.3058 ≈ {pyeongToSqm(34)}㎡</p>
  </section>

  <section>
    <h2>제곱미터 → 평 변환 방법</h2>
    <p>평 = 제곱미터 ÷ 3.3058 (= 제곱미터 × 0.3025)</p>
    <p>예: 84㎡ ÷ 3.3058 ≈ {sqmToPyeong(84)}평</p>
  </section>

  <section>
    <h2>자주 찾는 면적 (㎡ → 평)</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>제곱미터</th><th>평 (약)</th><th>비고</th></tr></thead>
        <tbody>
          {
            sqmToP.map((r) => (
              <tr>
                <td>{r.s}㎡</td>
                <td>
                  <strong>{r.p}평</strong>
                </td>
                <td>{r.s === 84 ? '국민주택 규모(85㎡) 근처' : r.s === 59 ? '소형 아파트' : '-'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>자주 찾는 평수 (평 → ㎡)</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>평</th><th>제곱미터 (약)</th></tr></thead>
        <tbody>
          {
            pToSqm.map((r) => (
              <tr>
                <td>{r.p}평</td>
                <td>
                  <strong>{r.s}㎡</strong>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>공급면적과 전용면적</h2>
    <p>
      아파트 "34평"은 보통 <strong>공급면적</strong>(전용 + 주거공용) 기준입니다. 실제 사용 공간인
      <strong>전용면적</strong>은 이보다 작습니다. 정확한 면적은 계약서·건축물대장에서 확인하세요.
      결과는 소수 둘째 자리에서 반올림합니다.
    </p>
  </section>

  <Faq items={FAQ} />
</CalculatorLayout>

<script>
  import { convertArea } from '../../lib/pyeong';

  const form = document.getElementById('py-form') as HTMLFormElement;
  const resultEl = document.getElementById('py-result') as HTMLElement;
  const errorEl = document.getElementById('py-error') as HTMLElement;

  function calculate() {
    try {
      const value = parseFloat((document.getElementById('value') as HTMLInputElement).value);
      const unit = (document.getElementById('unit') as HTMLSelectElement).value as 'pyeong' | 'sqm';
      const r = convertArea(value, unit);
      resultEl.innerHTML = `
        <dl>
          <dt>평</dt><dd><strong>${r.pyeong.toLocaleString()}평</strong></dd>
          <dt>제곱미터</dt><dd><strong>${r.sqm.toLocaleString()}㎡</strong></dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
