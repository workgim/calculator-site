---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('pyeong')!;
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="py-form">
      <div class="calc-row">
        <div class="calc-field">
          <label for="value">값</label>
          <input type="number" id="value" inputmode="decimal" step="any" min="0" placeholder="예: 34" required />
        </div>
        <div class="calc-field">
          <label for="unit">단위</label>
          <select id="unit">
            <option value="pyeong">평</option>
            <option value="sqm">제곱미터(㎡)</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn">변환</button>
    </form>

    <output id="py-result" class="calc-result" hidden></output>
    <p id="py-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>사용법</h2>
    <p>값을 입력하고 단위를 고르면 반대 단위로 변환합니다.</p>
  </section>

  <section>
    <h2>변환 기준</h2>
    <p><strong>1평 = 400 ÷ 121 ㎡ ≈ 3.3058 ㎡</strong></p>
    <table>
      <thead><tr><th>평</th><th>㎡ (약)</th><th>비고</th></tr></thead>
      <tbody>
        <tr><td>18평</td><td>59.5㎡</td><td>-</td></tr>
        <tr><td>25.7평</td><td>84.9㎡</td><td>국민주택 규모(85㎡) 근처</td></tr>
        <tr><td>34평</td><td>112.4㎡</td><td>-</td></tr>
        <tr><td>45평</td><td>148.8㎡</td><td>-</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      아파트 "34평"은 보통 <strong>공급면적</strong> 기준입니다. 전용면적은 이보다 작습니다(계약서·건축물대장
      확인). 결과는 소수 둘째 자리에서 반올림합니다.
    </p>
  </section>
</CalculatorLayout>

<script>
  import { convertArea } from '../../lib/pyeong';

  const form = document.getElementById('py-form') as HTMLFormElement;
  const resultEl = document.getElementById('py-result') as HTMLElement;
  const errorEl = document.getElementById('py-error') as HTMLElement;

  function calculate() {
    try {
      const value = parseFloat((document.getElementById('value') as HTMLInputElement).value);
      const unit = (document.getElementById('unit') as HTMLSelectElement).value as 'pyeong' | 'sqm';
      const r = convertArea(value, unit);
      resultEl.innerHTML = `
        <dl>
          <dt>평</dt><dd><strong>${r.pyeong.toLocaleString()}평</strong></dd>
          <dt>제곱미터</dt><dd><strong>${r.sqm.toLocaleString()}㎡</strong></dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
