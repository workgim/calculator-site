---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import AmountInput from '../../components/AmountInput.astro';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('savings')!;
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>
    <form id="sv-form">
      <div class="calc-field">
        <label for="type">종류</label>
        <select id="type">
          <option value="deposit">예금 (목돈을 한 번에 예치)</option>
          <option value="installment">적금 (매월 일정액 납입)</option>
        </select>
      </div>

      <AmountInput
        id="amount"
        label="금액 (원)"
        hint="예금은 예치 원금, 적금은 월 납입액"
        placeholder="예: 1000000"
        steps={[100_000, 1_000_000, 10_000_000]}
      />

      <div class="calc-row">
        <div class="calc-field">
          <label for="rate">연이율 (%)</label>
          <input type="number" id="rate" inputmode="decimal" step="0.01" min="0" placeholder="예: 3.5" required />
          <div class="stepper">
            <button type="button" data-step="0.1" data-target="rate">+0.1</button>
            <button type="button" data-step="0.5" data-target="rate">+0.5</button>
            <button type="button" data-step="clear" data-target="rate" class="stepper__clear" aria-label="지우기">C</button>
          </div>
        </div>
        <div class="calc-field">
          <label for="months">기간 (개월)</label>
          <input type="number" id="months" inputmode="numeric" step="1" min="1" max="600" placeholder="예: 12" required />
          <div class="stepper">
            <button type="button" data-step="1" data-target="months">+1</button>
            <button type="button" data-step="12" data-target="months">+12</button>
            <button type="button" data-step="clear" data-target="months" class="stepper__clear" aria-label="지우기">C</button>
          </div>
        </div>
      </div>

      <div class="calc-row">
        <div class="calc-field">
          <label for="method">이자 방식</label>
          <select id="method">
            <option value="simple">단리</option>
            <option value="compound">월복리</option>
          </select>
        </div>
        <div class="calc-field">
          <label for="tax">이자 과세</label>
          <select id="tax">
            <option value="normal">일반과세 (15.4%)</option>
            <option value="preferential">세금우대 (9.5%)</option>
            <option value="taxfree">비과세 (0%)</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="sv-result" class="calc-result" hidden></output>
    <p id="sv-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>사용법</h2>
    <p>
      예금/적금 종류를 고르고 금액·연이율·기간을 입력하세요. 예금은 <strong>예치 원금</strong>,
      적금은 <strong>매월 납입액</strong>을 넣습니다.
    </p>
  </section>

  <section>
    <h2>예금과 적금의 차이</h2>
    <ul>
      <li><strong>예금(거치식)</strong>: 목돈을 한 번에 넣고 만기까지 둡니다. 전체 기간 이자가 붙습니다.</li>
      <li>
        <strong>적금(정기적립)</strong>: 매월 나눠 넣습니다. 먼저 넣은 돈은 오래, 나중에 넣은 돈은
        짧게 이자가 붙어, 같은 이율·같은 총액이어도 예금보다 이자가 적습니다.
      </li>
    </ul>
  </section>

  <section>
    <h2>계산 방법</h2>
    <p>월이율 <em>i</em> = 연이율 ÷ 12 로 둡니다.</p>
    <ul>
      <li>예금 단리: 이자 = 원금 × 연이율 × (개월 ÷ 12)</li>
      <li>예금 월복리: 만기금액 = 원금 × (1 + i)<sup>개월</sup></li>
      <li>적금 단리: 이자 = 월납입액 × i × (개월 × (개월 + 1) ÷ 2)</li>
      <li>적금 월복리: 만기금액 = 월납입액 × (1 + i) × ((1 + i)<sup>개월</sup> − 1) ÷ i</li>
    </ul>
  </section>

  <section>
    <h2>이자소득세</h2>
    <p>
      이자에는 이자소득세가 붙습니다. 일반과세는 <strong>15.4%</strong>(소득세 14% + 지방소득세
      1.4%), 세금우대저축은 9.5%, 비과세종합저축 등은 0% 입니다. 이 계산기는 이자에 선택한 세율을
      적용해 세후 수령액을 보여줍니다.
    </p>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>
      실제 은행 상품은 이자를 일할로 계산하거나, 우대금리 조건, 중도해지 이율, 복리 적용 주기가
      달라 결과가 다를 수 있습니다. 이 계산기는 표준 공식에 따른 개략값입니다.
    </p>
    <p>근거: 이자소득세율(소득세법), 단리·복리 표준 공식.</p>
  </section>
</CalculatorLayout>

<script>
  import { calcSavings, type SavingsInput } from '../../lib/savings';
  import { parseAmount } from '../../lib/format';
  import { enhanceInputs } from '../../scripts/enhance-inputs';

  enhanceInputs();

  const form = document.getElementById('sv-form') as HTMLFormElement;
  const resultEl = document.getElementById('sv-result') as HTMLElement;
  const errorEl = document.getElementById('sv-error') as HTMLElement;
  const won = (n: number) => n.toLocaleString('ko-KR') + '원';
  const sel = (id: string) => (document.getElementById(id) as HTMLSelectElement).value;
  const num = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);

  function calculate() {
    try {
      const input: SavingsInput = {
        type: sel('type') as SavingsInput['type'],
        amount: parseAmount((document.getElementById('amount') as HTMLInputElement).value),
        annualRatePct: num('rate'),
        months: num('months'),
        method: sel('method') as SavingsInput['method'],
        tax: sel('tax') as SavingsInput['tax'],
      };
      const r = calcSavings(input);
      resultEl.innerHTML = `
        <dl>
          <dt>총 납입 원금</dt><dd>${won(r.principal)}</dd>
          <dt>세전 이자</dt><dd>${won(r.pretaxInterest)}</dd>
          <dt>이자 과세</dt><dd>− ${won(r.tax)}</dd>
          <dt>세후 이자</dt><dd>${won(r.aftertaxInterest)}</dd>
          <dt>세후 만기 수령액</dt><dd><strong>${won(r.maturityAmount)}</strong></dd>
        </dl>`;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculate();
  });
  form?.addEventListener('input', () => {
    if (!resultEl.hidden) calculate();
  });
</script>
