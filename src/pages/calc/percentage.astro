---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('percentage')!;
---

<CalculatorLayout calculator={calculator}>
  <section slot="calculator" class="calc-box" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="visually-hidden">계산기</h2>

    <div class="calc-field">
      <label for="mode">계산 종류</label>
      <select id="mode">
        <option value="percentOf">A의 B% 는 얼마?</option>
        <option value="whatPercent">A 는 B 의 몇 %?</option>
        <option value="changeRate">A 에서 B 로, 몇 % 증감?</option>
      </select>
    </div>

    <form id="pct-form">
      <div class="calc-field">
        <label for="a" id="label-a">A</label>
        <input type="number" id="a" inputmode="decimal" step="any" placeholder="예: 20000" required />
      </div>
      <div class="calc-field">
        <label for="b" id="label-b">B</label>
        <input type="number" id="b" inputmode="decimal" step="any" placeholder="예: 15" required />
      </div>
      <button type="submit" class="btn">계산하기</button>
    </form>

    <output id="pct-result" class="calc-result" hidden></output>
    <p id="pct-error" class="calc-error" role="alert" hidden></p>
  </section>

  <section>
    <h2>사용법</h2>
    <p>위에서 계산 종류를 고르고 두 값(A, B)을 입력한 뒤 <strong>계산하기</strong>를 누르세요.</p>
    <ul>
      <li><strong>A의 B%</strong>: 20,000의 15% → 3,000</li>
      <li><strong>A는 B의 몇 %</strong>: 3,000은 20,000의 → 15%</li>
      <li><strong>증감률</strong>: 20,000 → 23,000 → +15%</li>
    </ul>
  </section>

  <section>
    <h2>계산 방법</h2>
    <ul>
      <li>A의 B% = A × B ÷ 100</li>
      <li>A는 B의 몇 % = A ÷ B × 100</li>
      <li>증감률 = (나중값 − 처음값) ÷ |처음값| × 100</li>
    </ul>
  </section>

  <section>
    <h2>주의사항</h2>
    <p>결과는 소수 둘째 자리에서 반올림합니다. 기준값이 0이면 백분율을 계산할 수 없습니다.</p>
  </section>
</CalculatorLayout>

<script>
  import { percentOf, whatPercent, changeRate } from '../../lib/percentage';

  const form = document.getElementById('pct-form') as HTMLFormElement;
  const modeEl = document.getElementById('mode') as HTMLSelectElement;
  const labelA = document.getElementById('label-a') as HTMLElement;
  const labelB = document.getElementById('label-b') as HTMLElement;
  const resultEl = document.getElementById('pct-result') as HTMLElement;
  const errorEl = document.getElementById('pct-error') as HTMLElement;

  const labels: Record<string, [string, string]> = {
    percentOf: ['기준값 A', '비율 B (%)'],
    whatPercent: ['값 A', '기준값 B'],
    changeRate: ['처음 값 A', '나중 값 B'],
  };

  function syncLabels() {
    const [a, b] = labels[modeEl.value];
    labelA.textContent = a;
    labelB.textContent = b;
  }
  modeEl?.addEventListener('change', syncLabels);
  syncLabels();

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = parseFloat((document.getElementById('a') as HTMLInputElement).value);
    const b = parseFloat((document.getElementById('b') as HTMLInputElement).value);

    try {
      let text = '';
      if (modeEl.value === 'percentOf') {
        text = `${a.toLocaleString()}의 ${b}% 는 <strong>${percentOf(a, b).toLocaleString()}</strong> 입니다.`;
      } else if (modeEl.value === 'whatPercent') {
        text = `${a.toLocaleString()} 는 ${b.toLocaleString()} 의 <strong>${whatPercent(a, b)}%</strong> 입니다.`;
      } else {
        const r = changeRate(a, b);
        text = `${a.toLocaleString()} → ${b.toLocaleString()} 는 <strong>${r > 0 ? '+' : ''}${r}%</strong> 변화입니다.`;
      }
      resultEl.innerHTML = text;
      resultEl.hidden = false;
      errorEl.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : '계산할 수 없습니다.';
      errorEl.hidden = false;
      resultEl.hidden = true;
    }
  });
</script>
